{
  "SYSTEM":
  {
    "version": "1.0.0",
    "appName": "DesktopPet",
    "author": "nuo",
    "createDate": "2026-04-29",
    "lastUpdate": "2026-04-29",
    "autoSaveInterval": 300,
    "maxBackupCount": 10
  },
  "BUSINESS":
  {
    "enableAutoSave": true,
    "enableSync": false,
    "defaultNoteType": 0,
    "maxNoteCountPerFile": 1000,
    "dataRetentionDays": 30
  },
  "LOG":
  {
    "enableLog": true,
    "logLevel": "info",
    "logPath": "./logs/",
    "maxLogFileSize": 10485760,
    "maxLogFileCount": 5,
    "enableConsoleOutput": true
  },
  "DATA":
  {
    "dataPath": "./data/",
    "fileExtension": ".dat",
    "backupPath": "./backup/",
    "enableCompression": false,
    "encryptionEnabled": false
  },
  "DEFAULT":
  {
    "language": "zh_CN",
    "theme": "light",
    "fontSize": 12,
    "autoUpdate": true,
    "checkUpdateInterval": 86400
  },
  "UI":
  {
    "minWidth": 200,
    "minHeight": 300
  },
  "DATA_SAVE_FILE":
  {
    "fileLimit": 10000,
    "singleSaveCount": 100
  }
}